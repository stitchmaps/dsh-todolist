{
  "name": "todolist",
  "version": "0.2.1",
  "description": "DeepSeek Harness 待办清单插件：可折叠大卡片任务、截止时间（精确到小时）、按截止前 N 小时通过钉钉群机器人/工作通知推送提醒，并支持绑定工作区会话跳转。",
  "icon": "icon.svg",
  "author": "gary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stitchmaps/dsh-todolist.git"
  },
  "homepage": "https://github.com/stitchmaps/dsh-todolist#readme",
  "bugs": {
    "url": "https://github.com/stitchmaps/dsh-todolist/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "lib/client.js",
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "todolist",
    "todo",
    "task",
    "dingtalk",
    "reminder",
    "ui"
  ],
  "license": "MIT"
}
